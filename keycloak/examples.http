### ex1 Получение токена по паролю
# Надо взять корректный секрет для клиента

POST http://localhost:8080/realms/demo/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=demo-client&client_secret=CPxusYYfXSMc6da8XpIhwndUGokCxNw2&username=evgeniy&password=321


